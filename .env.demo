# 一键试玩专用环境变量。配合 docker-compose.demo.yml 使用：
#
#   docker compose --env-file .env.demo -f docker-compose.yml -f docker-compose.demo.yml up -d --build
#
# 这里的所有值都是公开的演示值，只在本机 http://localhost:8080 使用。
# NODE_ENV=production 时服务端会拒绝这些弱密钥和 http 地址，所以它们无法被误用于上线。
# 正式部署请复制 .env.example 为 .env 并填写自己的值，不要改这个文件。

NODE_ENV=development
ENABLE_FAKE_PROVIDER=true
FAKE_PROVIDER_DELAY_MS=1500
STORAGE_DRIVER=local

JWT_SECRET=lindyson-demo-only-not-for-production
CORS_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080
VITE_PUBLIC_SITE_URL=http://localhost:8080

MCP_ENABLED=false
REAL_PORTRAIT_PROVIDER_MODE=disabled

POSTGRES_PASSWORD=lindyson
WEB_HTTP_PORT=8080

# 演示管理员，启动后用它登录。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Demo12345
